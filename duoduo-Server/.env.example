# === 朵朵 DuoDuo 環境變數 ===

# Google Gemini API 金鑰（必填）
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL 密碼
POSTGRES_PASSWORD=duoduo_dev

# 單獨部署 backend 時需設定完整連線字串（scheme 須為 postgresql+asyncpg://）
# DATABASE_URL=postgresql+asyncpg://peimo:peimo_dev@localhost:5432/peimo

# ChromaDB 連線（docker-compose 會自動設定，單獨部署時需手動填）
CHROMA_HOST=localhost
CHROMA_PORT=8000

# 執行環境：development / production
ENVIRONMENT=development

# Docs credentials
DOCS_USERNAME=develop
DOCS_PASSWORD=develop

# Enable or disable auto-reload (true/false)
RELOAD=true